[Unit]
Description=AI SEO Content Factory
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/ai-seo-factory
EnvironmentFile=/var/www/ai-seo-factory/.env
ExecStart=/var/www/ai-seo-factory/.venv/bin/gunicorn -c deploy/gunicorn.conf.py app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
